# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Called the "anon" or "publishable" key in the dashboard. Safe to expose; RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the site lives (used for share links and sign-in redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" after enabling Google under Authentication > Providers.
NEXT_PUBLIC_AUTH_GOOGLE=false
